# https://docs.npmjs.com/cli/v10/using-npm/config#git-tag-version
git-tag-version = false

# Disables the post-install "run 'npm fund' to details" reminders.
fund=false

# Disables baseline vulnerability scans on every single package installation.
# Note: This heavily increases speed. Run manual audits with `npm audit` instead.
audit=false

# Mutes the large, distracting terminal alert boxes indicating a new npm CLI update exists.
update-notifier=false

# Filters log output to warnings and errors only. Keeps your terminal clean during installs.
# Options available: "silent", "error", "warn", "notice" (default), "info", "verbose", "silly"
loglevel=warn

# Suppresses the real-time visual package progress bar.
# Disabling this saves CPU cycles spent refreshing layout streams, making builds faster.
progress=false
